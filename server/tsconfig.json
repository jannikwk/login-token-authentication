{
  "compilerOptions": {
    // Output
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    // CommonJS output (no "type": "module" in package.json) so relative
    // imports can stay extensionless — Node's CJS resolver adds ".js".
    "module": "CommonJS",
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    // Strictness
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}